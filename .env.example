# Referência das variáveis lidas do ambiente de execução.
# Não coloque credenciais reais neste arquivo.
# O projeto não carrega este arquivo automaticamente.

POSTGRES_DSN=
SEMANTIC_AGENT_VERSION=
POSTGRES_CONNECT_TIMEOUT_SECONDS=10

# Engine Preflight live capability diagnostic only.
# Do not put real credentials in this file.
ENGINE_PREFLIGHT_PROVIDER_TYPE=capability_diagnostic
ENGINE_PREFLIGHT_CAPABILITY_MODE=unavailable
ENGINE_PREFLIGHT_DIALECT=
ENGINE_PREFLIGHT_ENDPOINT=
ENGINE_PREFLIGHT_AUTH_MODE=none
ENGINE_PREFLIGHT_OPERATION=
ENGINE_PREFLIGHT_TIMEOUT_SECONDS=5
ENGINE_PREFLIGHT_SSL_VERIFY=true

# Google Gemini SQL generator.
# GEMINI_API_KEY is the only required secret and must stay empty here.
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_SQL_GENERATOR_MODEL=gemini-2.5-flash
GEMINI_SQL_REPAIRER_MODEL=gemini-2.5-flash
GEMINI_CONNECT_TIMEOUT_SECONDS=
GEMINI_READ_TIMEOUT_SECONDS=
GEMINI_MAX_OUTPUT_TOKENS=8192

# LangGraph shadow TEST runtime. Values here are contracts/placeholders only.
LANGGRAPH_RUNTIME_MODE=shadow_test
LANGGRAPH_HTTP_HOST=127.0.0.1
LANGGRAPH_HTTP_PORT=8000
LANGGRAPH_SHADOW_PERSISTENCE=postgres
LANGGRAPH_SHADOW_DATABASE_DSN=
LANGGRAPH_ALLOW_REAL_SQL_EXECUTION=false
