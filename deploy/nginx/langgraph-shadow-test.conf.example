# Alternative deployment template only.
# Not used for the current Hostinger VPS target discovered in Microetapa 5.8.
# The current target uses Docker Compose + existing Traefik + n8n_default.

server {
    listen 80;
    server_name <LANGGRAPH_TEST_HOSTNAME>;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name <LANGGRAPH_TEST_HOSTNAME>;

    ssl_certificate <TLS_CERTIFICATE_PATH>;
    ssl_certificate_key <TLS_CERTIFICATE_KEY_PATH>;

    client_max_body_size 1m;

    proxy_connect_timeout 2s;
    proxy_send_timeout 5s;
    proxy_read_timeout 5s;

    location / {
        proxy_http_version 1.1;
        proxy_pass http://127.0.0.1:<LANGGRAPH_INTERNAL_PORT>;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Authorization $http_authorization;

        proxy_set_header Connection "";
    }
}
